               <item row="3" column="0" colspan="4">
                <widget class="QLabel" name="label_benchHint">
                 <property name="text">
                  <string>Used by Tools › Power-cycle ECU, Connect JTAG and Disconnect JTAG, and by Flash: before programming, WFlash power-cycles this ECU unless it was just powered on (instead of a reset). The power stays off 1 s and WFlash waits 1 s after power on. Never during programming: cutting the power then leaves the flash empty. Only the port and the relay of this ECU are switched.</string>
                 </property>
                 <property name="wordWrap">
                  <bool>true</bool>
                 </property>
                </widget>
               </item>
